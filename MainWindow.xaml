<Window x:Class="Perialls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Perialls"
        Title="Perialls" Width="660" Height="760" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        Foreground="#F2F2F2" FontFamily="Segoe UI">

    <!-- Sem a barra padrão do Windows, mas ainda dá para redimensionar pelas bordas. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Ícones: desenhos de linha simples numa área de 24x24. -->
        <Geometry x:Key="IconKeyboard">M4,6.5 H20 A2,2 0 0 1 22,8.5 V15.5 A2,2 0 0 1 20,17.5 H4 A2,2 0 0 1 2,15.5 V8.5 A2,2 0 0 1 4,6.5 Z M6,10 H6.01 M10,10 H10.01 M14,10 H14.01 M18,10 H18.01 M8,14 H16</Geometry>
        <Geometry x:Key="IconMouse">M12,3 A6,6 0 0 1 18,9 V15 A6,6 0 0 1 6,15 V9 A6,6 0 0 1 12,3 Z M12,7 V10</Geometry>
        <Geometry x:Key="IconHeadset">M4,15 V12 A8,8 0 0 1 20,12 V15 M4,15 H7 V20 H5 A1,1 0 0 1 4,19 Z M20,15 H17 V20 H19 A1,1 0 0 0 20,19 Z</Geometry>
        <Geometry x:Key="IconController">M7.5,7 H16.5 A4.5,4.5 0 0 1 21,11.5 L21.6,16.2 A2.2,2.2 0 0 1 17.7,17.9 L15.8,15.5 H8.2 L6.3,17.9 A2.2,2.2 0 0 1 2.4,16.2 L3,11.5 A4.5,4.5 0 0 1 7.5,7 Z M7,10 V13 M5.5,11.5 H8.5 M16,10.5 H16.01 M18,12.5 H18.01</Geometry>
        <Geometry x:Key="IconFan">M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 Z M12,10.5 A1.5,1.5 0 1 1 12,13.5 A1.5,1.5 0 1 1 12,10.5 Z M12,10.5 C11,8 12,5.5 14.5,5.5 C15.5,7.5 14.5,9.8 13.2,10.9 Z M13.3,12.75 C15.96,13.13 17.63,15.25 16.38,17.42 C14.15,17.28 12.66,15.27 12.35,13.59 Z M10.7,12.75 C9.04,14.87 6.37,15.25 5.12,13.09 C6.35,11.22 8.85,10.94 10.45,11.51 Z</Geometry>
        <Geometry x:Key="IconDevice">M9,3 V8 M15,3 V8 M7,8 H17 V13 A5,5 0 0 1 7,13 Z M12,18 V21</Geometry>
        <Geometry x:Key="IconRefresh">M20,12 A8,8 0 1 1 17.66,6.34 M17.5,2.5 V6.5 H21.5</Geometry>
        <Geometry x:Key="IconEye">M2,12 C5,6.5 19,6.5 22,12 C19,17.5 5,17.5 2,12 Z M12,9.5 A2.5,2.5 0 1 1 12,14.5 A2.5,2.5 0 1 1 12,9.5 Z</Geometry>
        <Geometry x:Key="IconEyeOff">M2,12 C5,6.5 19,6.5 22,12 C19,17.5 5,17.5 2,12 Z M12,9.5 A2.5,2.5 0 1 1 12,14.5 A2.5,2.5 0 1 1 12,9.5 Z M4,4 L20,20</Geometry>
        <Geometry x:Key="IconClose">M7,7 L17,17 M17,7 L7,17</Geometry>
        <Geometry x:Key="IconMinimize">M7,12 H17</Geometry>

        <!-- Cores rápidas para RGB. A última (preto) desliga os LEDs. -->
        <x:Array x:Key="Swatches" Type="sys:String">
            <sys:String>#FF0000</sys:String>
            <sys:String>#FF6A00</sys:String>
            <sys:String>#FFD000</sys:String>
            <sys:String>#00FF40</sys:String>
            <sys:String>#00E5FF</sys:String>
            <sys:String>#0040FF</sys:String>
            <sys:String>#8A00FF</sys:String>
            <sys:String>#FF00A0</sys:String>
            <sys:String>#FFFFFF</sys:String>
            <sys:String>#000000</sys:String>
        </x:Array>

        <!-- Níveis de brilho e velocidade dos teclados Akko/MonsGeek (0 a 4). -->
        <x:Array x:Key="KeyboardLevels" Type="sys:Int32">
            <sys:Int32>0</sys:Int32>
            <sys:Int32>1</sys:Int32>
            <sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32>
            <sys:Int32>4</sys:Int32>
        </x:Array>

        <!-- Desenho de linha branca: o ícone escolhido conforme o tipo do aparelho (propriedade Icon). -->
        <Style x:Key="TypeIcon" TargetType="Path">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Data" Value="{StaticResource IconDevice}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="keyboard">
                    <Setter Property="Data" Value="{StaticResource IconKeyboard}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="mouse">
                    <Setter Property="Data" Value="{StaticResource IconMouse}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="headset">
                    <Setter Property="Data" Value="{StaticResource IconHeadset}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="controller">
                    <Setter Property="Data" Value="{StaticResource IconController}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="fan">
                    <Setter Property="Data" Value="{StaticResource IconFan}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ícone de linha branca simples (para os botões). -->
        <Style x:Key="LineIcon" TargetType="Path">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- Botão discreto: transparente, clareia ao passar o mouse. -->
        <Style x:Key="GhostButton" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1F1F24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão liga/desliga: fica com fundo cinza quando ativado. -->
        <Style x:Key="GhostToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhostButton}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2A2A30"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botãozinho em formato de pílula (valores de DPI). -->
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#16161A"/>
        </Style>

        <!-- Pílula que fica destacada quando é o valor atual. O valor atual fica no Tag da lista de botões.
             (Texto continua branco: ao passar o mouse o fundo escurece, e texto preto sumiria.) -->
        <local:SameValueConverter x:Key="SameValue"/>
        <Style x:Key="ValuePill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource SameValue}">
                            <Binding/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#55555F"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallBox" TargetType="TextBox">
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#0A0A0C"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/>
            <Setter Property="CaretBrush" Value="#F2F2F2"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <!-- Moldura: fundo preto bem arredondado e, por dentro, uma borda fina branca. -->
    <Border Background="Black" CornerRadius="24" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border BorderBrush="#D0FFFFFF" BorderThickness="1" CornerRadius="18" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Barra lateral -->
                <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center">
                    <Button x:Name="RefreshButton" Click="Refresh_Click" ToolTip="Atualizar"
                            Style="{StaticResource GhostButton}" Margin="0,0,0,8">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconRefresh}"/>
                        </Viewbox>
                    </Button>
                    <ToggleButton x:Name="ShowHiddenBox" ToolTip="Mostrar aparelhos ocultos"
                                  Checked="ShowHidden_Changed" Unchecked="ShowHidden_Changed"
                                  Style="{StaticResource GhostToggle}" Margin="0,0,0,8">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconEye}"/>
                        </Viewbox>
                    </ToggleButton>
                    <Button x:Name="StartOpenRgbButton" Click="StartOpenRgb_Click" Visibility="Collapsed"
                            ToolTip="Abrir o OpenRGB (para controlar o RGB)" Style="{StaticResource GhostButton}">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconFan}"/>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- Linha vertical que separa a barra lateral -->
                <Rectangle Grid.Column="1" Fill="#333338" Margin="0,18"/>

                <!-- Conteúdo -->
                <Grid Grid.Column="2" Margin="12,10,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Topo: título e botões de minimizar/fechar -->
                    <DockPanel Margin="6,0,0,8">
                        <Button DockPanel.Dock="Right" Click="Close_Click" ToolTip="Fechar"
                                Style="{StaticResource GhostButton}" Padding="4">
                            <Viewbox Width="16" Height="16">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconClose}"/>
                            </Viewbox>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="Minimize_Click" ToolTip="Minimizar"
                                Style="{StaticResource GhostButton}" Padding="4" Margin="0,0,4,0">
                            <Viewbox Width="16" Height="16">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconMinimize}"/>
                            </Viewbox>
                        </Button>
                        <TextBlock Text="Periféricos" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Grade de cartões: a largura de cada cartão é calculada em Cards_SizeChanged -->
                    <ScrollViewer x:Name="CardsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  SizeChanged="Cards_SizeChanged">
                        <ItemsControl x:Name="DeviceList" Tag="240">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#3A3A40" BorderThickness="1" CornerRadius="10"
                                            Background="#08080A" Margin="5" Padding="12"
                                            Opacity="{Binding Opacity}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Foto do aparelho... -->
                                            <Image Source="{Binding Photo}" Stretch="Uniform" Margin="18,6"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <!-- ...ou, sem foto, o ícone do tipo em tamanho grande -->
                                            <Viewbox Width="56" Height="56">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Photo}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <Path Style="{StaticResource TypeIcon}" StrokeThickness="1.1"/>
                                            </Viewbox>

                                            <!-- Ícone pequeno do tipo, no canto -->
                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Path Style="{StaticResource TypeIcon}"/>
                                            </Viewbox>

                                            <!-- Ocultar/mostrar: aparece ao passar o mouse sobre o cartão -->
                                            <Button Click="ToggleHidden_Click" ToolTip="{Binding HideLabel}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-6,-6,0" Padding="4">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Viewbox Width="14" Height="14">
                                                    <Path StrokeThickness="1.6">
                                                        <Path.Style>
                                                            <Style TargetType="Path" BasedOn="{StaticResource LineIcon}">
                                                                <Setter Property="Stroke" Value="#9A9AA5"/>
                                                                <Setter Property="Data" Value="{StaticResource IconEyeOff}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                        <Setter Property="Data" Value="{StaticResource IconEye}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Viewbox>
                                            </Button>

                                            <!-- Nome e status -->
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Margin="0,8,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/>
                                            <TextBlock Grid.Row="2" Foreground="#A8A8B3" FontSize="12" Margin="0,2,0,0"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Kind, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding Status, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Row="3" Foreground="#D8D8DE" FontSize="12" Margin="0,2,0,0"
                                                       TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Battery}" Value="—">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="Bateria"/>
                                                <Run Text="{Binding Battery, Mode=OneWay}"/>
                                            </TextBlock>

                                            <!-- Extras: cores (OpenRGB) e DPI (HID++) -->
                                            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                                                <WrapPanel HorizontalAlignment="Center">
                                                    <WrapPanel.Style>
                                                        <Style TargetType="WrapPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasRgb}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </WrapPanel.Style>
                                                    <ItemsControl ItemsSource="{StaticResource Swatches}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- Tag = o aparelho deste cartão; o próprio item = a cor -->
                                                                <Button Click="Swatch_Click" Cursor="Hand" Margin="0,0,5,5"
                                                                        ToolTip="{Binding}"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Ellipse Width="16" Height="16" Fill="{Binding}"
                                                                                     Stroke="#55555F" StrokeThickness="1"/>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Cor personalizada: digite um código como #FF8800 e aperte Enter -->
                                                    <TextBox Width="64" Text="#" Style="{StaticResource SmallBox}"
                                                             ToolTip="Cor personalizada (ex.: #FF8800) + Enter"
                                                             KeyDown="CustomColor_KeyDown"/>
                                                </WrapPanel>

                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDpi}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock FontSize="12" Foreground="#D8D8DE" TextAlignment="Center" Margin="0,0,0,6">
                                                        <Run Text="DPI"/>
                                                        <Run Text="{Binding Dpi, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <WrapPanel HorizontalAlignment="Center">
                                                        <ItemsControl ItemsSource="{Binding DpiPresets}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding}" Click="DpiPreset_Click"
                                                                            Style="{StaticResource PillButton}"
                                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <!-- DPI personalizado: digite e aperte Enter -->
                                                        <TextBox Width="56" Style="{StaticResource SmallBox}"
                                                                 ToolTip="DPI personalizado + Enter"
                                                                 KeyDown="DpiCustom_KeyDown"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Teclado Akko/MonsGeek: efeito, brilho, velocidade e Hz -->
                                                <StackPanel Margin="0,4,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasKeyboardLighting}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ComboBox ItemsSource="{x:Static local:MonsGeekKeyboard.Effects}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                                              SelectedValue="{Binding KeyboardEffect, Mode=OneWay}"
                                                              SelectionChanged="KeyboardEffect_Changed"
                                                              FontSize="11" MinWidth="140" HorizontalAlignment="Center"
                                                              Margin="0,0,0,8" ToolTip="Efeito de iluminação"/>

                                                    <TextBlock FontSize="12" Foreground="#D8D8DE" TextAlignment="Center" Margin="0,0,0,4">
                                                        <Run Text="Brilho"/>
                                                        <Run Text="{Binding KeyboardLighting.Brightness, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{StaticResource KeyboardLevels}" HorizontalAlignment="Center"
                                                                  Tag="{Binding KeyboardLighting.Brightness}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding}" Click="KeyboardBrightness_Click"
                                                                        Style="{StaticResource ValuePill}"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock FontSize="12" Foreground="#D8D8DE" TextAlignment="Center" Margin="0,4,0,4">
                                                        <Run Text="Velocidade"/>
                                                        <Run Text="{Binding KeyboardLighting.Speed, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{StaticResource KeyboardLevels}" HorizontalAlignment="Center"
                                                                  Tag="{Binding KeyboardLighting.Speed}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding}" Click="KeyboardSpeed_Click"
                                                                        Style="{StaticResource ValuePill}"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock FontSize="12" Foreground="#D8D8DE" TextAlignment="Center" Margin="0,4,0,4">
                                                        <Run Text="Taxa de atualização"/>
                                                        <Run Text="{Binding ReportRateHz, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="Hz"/>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{x:Static local:MonsGeekKeyboard.ReportRates}" HorizontalAlignment="Center"
                                                                  Tag="{Binding ReportRateHz}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel HorizontalAlignment="Center"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding}" Click="ReportRate_Click"
                                                                        Style="{StaticResource ValuePill}"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Rodapé com mensagens -->
                    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="6,8,0,0" Foreground="#8A8A95"
                               FontSize="11" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
