<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="OpenRGB.NET" Version="3.1.1" />
    <!-- Só é usado no Windows (WMI). No Linux a lista vem de /sys. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Os testes (tests/Perialls.Tests) são um projeto à parte: não entram no executável. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <!-- Os testes também conferem partes internas (ex.: a comparação da cor lida de volta). -->
    <InternalsVisibleTo Include="Perialls.Tests" />
  </ItemGroup>

  <!-- Logo e fotos dos aparelhos: tudo em Assets vai para dentro do executável. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Lang\**" />
  </ItemGroup>

  <!-- Textos da tela (português e inglês). -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Lang\*.json" LogicalName="Lang.%(Filename).json" />
  </ItemGroup>

</Project>
